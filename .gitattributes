* text=auto

# Vendored third-party headers: keep the bytes exactly as upstream shipped them, so the
# hashes in external/reshade/NOTICE.md still verify after a clone.
external/reshade/*.h  -text
external/reshade/*.hpp -text

# ReShade wants CRLF in .ini files it reads back.
*.ini text eol=crlf

# Checksum lists are fed to sha256sum -c, which chokes on the CR. Keep them LF.
tools/SHA256SUMS.txt -text

media/* binary
